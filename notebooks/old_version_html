      const values = spec.series.flatMap(s => s.values.filter(v => v !== null && !Number.isNaN(Number(v))).map(v => Number(v)));
      if (!values.length) {
        wrap.innerHTML = '<div class="note">Not available in current data.</div>';
        return;
      }
      let minY = Math.min(0, ...values);
      let maxY = Math.max(...values);
      if (minY === maxY) maxY += 1;
      const pad = (maxY - minY) * 0.12 || 1;
      minY -= pad * (minY < 0 ? .4 : 0);
      maxY += pad;
      const groupW = plotW / labels.length;
      const barW = Math.min(36, (groupW * .72) / spec.series.length);
      const xPos = (groupIdx, seriesIdx) => margin.left + groupIdx * groupW + (groupW - barW * spec.series.length) / 2 + seriesIdx * barW;
      const yPos = val => margin.top + (maxY - val) / (maxY - minY) * plotH;
      const baseline = yPos(0);

      for (let i = 0; i < 4; i++) {
        const yVal = minY + (maxY - minY) * (i / 3);
        const y = yPos(yVal);
        const line = document.createElementNS(svg.namespaceURI, 'line');
        line.setAttribute('x1', margin.left);
        line.setAttribute('x2', margin.left + plotW);
        line.setAttribute('y1', y);
        line.setAttribute('y2', y);
        line.setAttribute('stroke', 'rgba(21,33,47,.08)');
        svg.appendChild(line);
      }
      const axis = document.createElementNS(svg.namespaceURI, 'line');
      axis.setAttribute('x1', margin.left);
      axis.setAttribute('x2', margin.left + plotW);
      axis.setAttribute('y1', baseline);
      axis.setAttribute('y2', baseline);
      axis.setAttribute('stroke', 'rgba(21,33,47,.35)');
      svg.appendChild(axis);

      spec.series.forEach((series, sIdx) => {
        series.values.forEach((v, idx) => {
          if (v === null || Number.isNaN(Number(v))) return;
          const y = yPos(Number(v));
          const rect = document.createElementNS(svg.namespaceURI, 'rect');
          rect.setAttribute('x', xPos(idx, sIdx));
          rect.setAttribute('y', Math.min(y, baseline));
          rect.setAttribute('width', barW - 2);
          rect.setAttribute('height', Math.max(2, Math.abs(baseline - y)));
          rect.setAttribute('fill', series.color);
          rect.addEventListener('mousemove', evt => showTip(wrap, `<strong>${series.name}</strong><br>${labels[idx]}: ${fmt(v, spec.yDigits ?? 1)}`, evt));
          rect.addEventListener('mouseleave', () => hideTip(wrap));
          svg.appendChild(rect);
        });
      });
      labels.forEach((labelText, idx) => {
        const txt = document.createElementNS(svg.namespaceURI, 'text');
        txt.setAttribute('x', margin.left + groupW * idx + groupW / 2);
        txt.setAttribute('y', margin.top + plotH + 20);
        txt.setAttribute('text-anchor', 'middle');
        txt.setAttribute('font-size', '11');
        txt.setAttribute('fill', '#607181');
        txt.textContent = labelText;
        svg.appendChild(txt);
      });
      wrap.appendChild(svg);
      const legend = document.createElement('div');
      legend.className = 'chart-legend';
      spec.series.forEach(series => {
        const item = document.createElement('div');
        item.className = 'legend-btn';
        item.innerHTML = `<span class="legend-swatch" style="background:${series.color}"></span>${series.name}`;
        legend.appendChild(item);
      });
      wrap.appendChild(legend);
    }

    function renderPercentiles(targetId, rows, season) {
      const container = document.getElementById(targetId);
      if (!container) return;
      const filtered = rows.filter(r => Number(r.season) === Number(season));
      if (!filtered.length) {
        container.innerHTML = '<div class="note">Percentiles not available for this season.</div>';
        return;
      }
      container.innerHTML = filtered.map(row => {
        const pct = row.percentile === null || row.percentile === undefined ? 'NA' : Math.round(row.percentile * 100) + '%';
        const width = row.percentile ? Math.round(row.percentile * 100) : 0;
        return `
          <div class="card" style="padding:12px 14px">
            <div class="label">${row.metric_label}</div>
            <div style="display:flex;justify-content:space-between;align-items:center;gap:14px">
              <div style="flex:1;height:10px;background:rgba(21,33,47,.08);border-radius:999px;overflow:hidden">
                <div style="width:${width}%;height:100%;background:linear-gradient(90deg,var(--sky),var(--gold))"></div>
              </div>
              <strong style="font:700 13px Arial,sans-serif">${pct}${row.emoji}</strong>
            </div>
          </div>
        `;
      }).join('');
    }

    function makeKpis() {
      const meta = bundle.player_meta;
      const hist = bundle.season_history || [];
      const latest = hist.find(r => Number(r.season) === meta.season_end) || hist[hist.length - 1];
      const first = hist.find(r => Number(r.season) === meta.season_start) || hist[0];
      const onoff = bundle.regular_onoff_history || [];
      const latestOnOff = onoff.find(r => Number(r.season) === meta.season_end) || onoff[onoff.length - 1] || null;
      const kpis = [
        {
          label: '2026 Scoring',
          value: latest ? fmt(latest.pts_per40, 1) : 'NA',
          note: latest ? `${fmt(latest.ts_pct * 100, 1)} TS% · ${fmt(latest.fg3_pct * 100, 1)} 3P%` : 'Season row not available'
        },
        {
          label: 'Development Delta',
          value: latest && first ? (latest.pts_per40 - first.pts_per40 >= 0 ? '+' : '') + fmt(latest.pts_per40 - first.pts_per40, 1) : 'NA',
          note: `Points per 40 from ${labelSeason(meta.season_start)} to ${labelSeason(meta.season_end)}`
        },
        {
          label: '2026 Usage',
          value: latest ? fmtPct(latest.usage_proxy, 1) : 'NA',
          note: latest ? `${fmt(latest.ast_to_tov, 2)} AST:TOV · ${fmt(latest.games_played, 0)} regular-season games` : 'Not available'
        },
        {
          label: 'On/Off Swing',
          value: latestOnOff ? fmt(latestOnOff.net_rtg_diff, 1) : 'NA',
          note: latestOnOff ? `${labelSeason(latestOnOff.season)} regular season` : 'Unavailable for seasons without substitutions in raw PBP'
        }
      ];
      document.getElementById('kpi-grid').innerHTML = kpis.map(k => `<div class="card"><div class="label">${k.label}</div><div class="value">${k.value}</div><div class="note">${k.note}</div></div>`).join('');
    }

    function makeTables() {
      const lineup = bundle.regular_lineup_summary || [];
      const lineupEl = document.getElementById('lineup-table');
      if (lineupEl) {
        if (!lineup.length) {
          lineupEl.innerHTML = `<div class="note">${meta.team_name} lineup stints are only available for seasons where the raw PBP includes substitution events.</div>`;
        } else {
          lineupEl.innerHTML = `
            <div class="table-shell">
              <table>
                <thead><tr><th>Season</th><th>Lineup IDs</th><th>Minutes</th><th>Net RTG</th><th>Stints</th></tr></thead>
                <tbody>
                  ${lineup.map(r => `<tr><td>${labelSeason(r.season)}</td><td>${r.lineup_str}</td><td>${fmt(r.minutes,1)}</td><td>${fmt(r.net_rtg,1)}</td><td>${fmt(r.stints,0)}</td></tr>`).join('')}
                </tbody>
              </table>
            </div>
          `;
        }
      }
      const notes = document.getElementById('availability-notes');
      if (notes) {
        notes.innerHTML = (bundle.availability_notes || []).map(note => `<div class="card"><div class="note">${note}</div></div>`).join('');
      }
    }

    function buildCharts() {
      const hist = bundle.season_history || [];
      const pbp = bundle.pbp_profile_history || [];
      const onoff = bundle.regular_onoff_history || [];
      const recent = bundle.recent_form_2026 || [];
      const labels = hist.map(r => labelSeason(r.season));

      renderLineChart('chart-development', [
        { name:'PTS/40', color:'#12324a', labels, values:hist.map(r => r.pts_per40) },
        { name:'AST/40', color:'#5c8fb7', labels, values:hist.map(r => r.ast_per40) },
        { name:'REB/40', color:'#d8a324', labels, values:hist.map(r => r.reb_per40) }
      ], { yDigits:1 });

      renderLineChart('chart-efficiency', [
        { name:'TS%', color:'#1f7a5b', labels, values:hist.map(r => r.ts_pct ? r.ts_pct * 100 : null) },
        { name:'eFG%', color:'#d95f44', labels, values:hist.map(r => r.efg_pct ? r.efg_pct * 100 : null) },
        { name:'3P%', color:'#607181', labels, values:hist.map(r => r.fg3_pct ? r.fg3_pct * 100 : null) }
      ], { yDigits:1 });

      renderGroupedBars('chart-shot-mix', {
        labels: pbp.map(r => labelSeason(r.season)),
        yDigits: 1,
        series: [
          { name:'Paint Share %', color:'#12324a', values: pbp.map(r => r.paint_share ? r.paint_share * 100 : null) },
          { name:'Midrange Share %', color:'#d95f44', values: pbp.map(r => r.midrange_share ? r.midrange_share * 100 : null) },
          { name:'Three Share %', color:'#d8a324', values: pbp.map(r => r.three_share ? r.three_share * 100 : null) }
        ]
      });

      renderGroupedBars('chart-creation', {
        labels: pbp.map(r => labelSeason(r.season)),
        yDigits: 1,
        series: [
          { name:'Assisted FG Rate %', color:'#5c8fb7', values: pbp.map(r => r.assisted_fg_rate ? r.assisted_fg_rate * 100 : null) },
          { name:'Unassisted FG Rate %', color:'#d95f44', values: pbp.map(r => r.unassisted_fg_rate ? r.unassisted_fg_rate * 100 : null) }
        ]
      });

      renderGroupedBars('chart-onoff', {
        labels: onoff.map(r => labelSeason(r.season)),
        yDigits: 1,
        series: [
          { name:'Net RTG Diff', color:'#12324a', values: onoff.map(r => r.net_rtg_diff) },
          { name:'Off RTG Diff', color:'#d8a324', values: onoff.map(r => r.off_rtg_diff) },
          { name:'Def RTG Diff', color:'#5c8fb7', values: onoff.map(r => r.def_rtg_diff) }
        ]
      });

      renderGroupedBars('chart-opp-defense', {
        labels: onoff.map(r => labelSeason(r.season)),
        yDigits: 1,
        series: [
          { name:'Opp FG% Allowed On', color:'#12324a', values: onoff.map(r => r.on_opp_fg_pct ? r.on_opp_fg_pct * 100 : null) },
          { name:'Opp FG% Allowed Off', color:'#607181', values: onoff.map(r => r.off_opp_fg_pct ? r.off_opp_fg_pct * 100 : null) },
          { name:'Opp eFG% Allowed Diff', color:'#d95f44', values: onoff.map(r => r.opp_efg_pct_allowed_diff ? r.opp_efg_pct_allowed_diff * 100 : null) }
        ]
      });

      renderLineChart('chart-recent', [
        { name:'Game Score', color:'#12324a', labels: recent.map(r => r.game_date ? String(r.game_date).slice(5,10) : ''), values: recent.map(r => r.game_score) },
        { name:'TS% Game', color:'#d8a324', labels: recent.map(r => r.game_date ? String(r.game_date).slice(5,10) : ''), values: recent.map(r => r.ts_pct_game ? r.ts_pct_game * 100 : null) }
      ], { yDigits:1, legend:true });

      renderPercentiles('percentiles-grid', bundle.position_percentiles || [], bundle.player_meta.season_end);
      if (!isDashboard) {
        renderPercentiles('percentiles-early', bundle.position_percentiles || [], bundle.player_meta.season_start);
      }
    }

    function setupTabs() {
      document.querySelectorAll('.tab-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const target = btn.dataset.tab;
          document.querySelectorAll('.tab-btn').forEach(el => el.classList.toggle('active', el === btn));
          document.querySelectorAll('.tab-panel').forEach(panel => panel.classList.toggle('active', panel.id === target));
        });
      });
    }

    document.addEventListener('DOMContentLoaded', () => {
      makeKpis();
      buildCharts();
      makeTables();
      setupTabs();
    });
    </script>
    
    </body>
    </html>
    
