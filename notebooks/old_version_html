    .hero{display:grid;grid-template-columns:1.25fr .95fr;gap:24px;align-items:end;margin-bottom:24px}
    .eyebrow{font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);margin-bottom:10px}
    h1{margin:0;font-size:clamp(34px,5vw,62px);line-height:.95}
    .dek{font-size:18px;line-height:1.65;max-width:68ch;margin-top:16px}
    .scorecard{background:linear-gradient(180deg,#15334d,#0f2233);color:#fff;border-radius:24px;padding:22px 22px 18px;box-shadow:var(--shadow)}
    .scorecard p{margin:10px 0 0;line-height:1.55;color:rgba(255,255,255,.9)}
    .topnav{position:sticky;top:0;z-index:50;background:rgba(250,247,242,.92);backdrop-filter:blur(8px);border:1px solid var(--line);border-radius:16px;padding:10px 12px;margin-bottom:24px;display:flex;gap:10px;flex-wrap:wrap}
