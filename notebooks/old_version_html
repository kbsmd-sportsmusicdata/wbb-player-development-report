    .topnav a:hover,.tab-btn:hover,.tab-btn.active{background:var(--navy);color:#fff;border-color:var(--navy)}
    .kpi-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px;margin:18px 0 28px}
    .card{background:var(--card);border:1px solid var(--line);border-radius:20px;padding:16px 16px 14px;box-shadow:0 10px 22px rgba(0,0,0,.04)}
    .label{font:600 11px/1.2 Arial,sans-serif;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);margin-bottom:8px}
    .value{font-size:30px;font-weight:700;line-height:1.05}
    .note{font-size:14px;line-height:1.55;color:#364757;margin-top:8px}
    .section{display:grid;grid-template-columns:220px 1fr;gap:22px;padding-top:24px;margin-top:24px;border-top:1px solid var(--line)}
    .section h2{margin:0;font-size:22px;position:sticky;top:80px;align-self:start}
    .section-body{display:grid;gap:16px}
    .copy{font-size:17px;line-height:1.72}
    .chart-card{background:#fff;border:1px solid var(--line);border-radius:20px;padding:14px 14px 8px;box-shadow:0 10px 22px rgba(0,0,0,.04)}
    .chart-title{font:700 14px/1.3 Arial,sans-serif;margin-bottom:6px;color:var(--ink)}
    .chart-wrap{position:relative}
    .chart-tooltip{position:absolute;pointer-events:none;background:rgba(17,29,42,.94);color:#fff;padding:8px 10px;border-radius:10px;font:12px/1.45 Arial,sans-serif;box-shadow:0 10px 24px rgba(0,0,0,.25);display:none;max-width:240px}
    .chart-legend{display:flex;gap:10px;flex-wrap:wrap;margin:8px 0 0}
    .legend-btn{background:none;border:none;padding:0;font:600 12px/1.3 Arial,sans-serif;color:var(--ink);display:flex;align-items:center;gap:6px;cursor:pointer}
    .legend-swatch{width:10px;height:10px;border-radius:999px;display:inline-block}
    .mini-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}
    .table-shell{overflow:auto;background:#fff;border:1px solid var(--line);border-radius:18px}
    table{width:100%;border-collapse:collapse;font:14px/1.45 Arial,sans-serif}
    th,td{padding:10px 12px;border-bottom:1px solid var(--line);text-align:left;vertical-align:top}
    th{font-size:12px;letter-spacing:.05em;text-transform:uppercase;color:var(--muted);background:rgba(243,239,232,.9)}
    .pill{display:inline-flex;align-items:center;gap:6px;padding:6px 10px;border-radius:999px;background:#fff;border:1px solid var(--line);font:600 12px/1.2 Arial,sans-serif}
